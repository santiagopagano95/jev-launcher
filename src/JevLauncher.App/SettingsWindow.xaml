<Window x:Class="JevLauncher.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jev Launcher — Settings" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource PanelSolid}">
  <Window.Resources>
    <Style x:Key="Field" TargetType="Control">
      <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
      <Setter Property="Background" Value="#262626" />
      <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Foreground" Value="{StaticResource TextHint}" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border CornerRadius="8" Background="{StaticResource AccentGradient}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
      <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
      <Setter Property="Padding" Value="14,6" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border CornerRadius="8" Background="#262626" BorderBrush="{StaticResource Hairline}"
                    BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="SettingsRoot" Background="{StaticResource PanelSolid}">
    <StackPanel Margin="20">
    <TextBlock Text="TypeSafe API key" Style="{StaticResource FieldLabel}" />
    <PasswordBox x:Name="ApiKeyBox" Style="{StaticResource Field}" Margin="0,0,0,6" />
    <TextBlock x:Name="EnvNote" FontFamily="{StaticResource MonoFont}" FontSize="10.5"
               Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,16" />

    <TextBlock Text="Hotkey — focus the box and press a combination" Style="{StaticResource FieldLabel}" />
    <TextBox x:Name="HotkeyBox" Style="{StaticResource Field}" FontFamily="{StaticResource MonoFont}"
             IsReadOnly="True" Margin="0,0,0,16" PreviewKeyDown="OnHotkeyKeyDown" />

    <TextBlock Text="Search URL template — use {0} for the query" Style="{StaticResource FieldLabel}" />
    <TextBox x:Name="TemplateBox" Style="{StaticResource Field}" Margin="0,0,0,16" />

    <TextBlock Text="Snippets — one per line: name = text" Style="{StaticResource FieldLabel}" />
    <TextBox x:Name="SnippetsBox" Style="{StaticResource Field}" AcceptsReturn="True" Height="90"
             VerticalScrollBarVisibility="Auto" Margin="0,0,0,16" />

    <TextBlock x:Name="TestResult" FontFamily="{StaticResource MonoFont}" FontSize="11"
               Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,16" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="TestButton" Content="Test connection" Style="{StaticResource SecondaryButton}"
              Click="OnTestClick" Margin="0,0,8,0" />
      <Button Content="Cancel" Style="{StaticResource SecondaryButton}" IsCancel="True" Margin="0,0,8,0" />
      <Button Content="Save" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnSaveClick" />
    </StackPanel>
  </StackPanel>
  </Border>
</Window>
