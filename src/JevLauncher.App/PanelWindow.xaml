<Window x:Class="JevLauncher.App.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="False" ShowInTaskbar="False"
        Topmost="True" ResizeMode="NoResize" SizeToContent="Height"
        Width="640" Background="#01000000" WindowStartupLocation="Manual"
        PreviewKeyDown="OnPreviewKeyDown"
        Deactivated="OnDeactivated"
        Activated="OnActivated"
        Loaded="OnLoaded">
  <Border x:Name="RootBorder" CornerRadius="14" Background="{StaticResource PanelBackground}"
          BorderBrush="{StaticResource Hairline}" BorderThickness="1">
    <StackPanel>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="2"/>
        </Grid.RowDefinitions>
        <TextBox x:Name="QueryBox" FontSize="20" BorderThickness="0"
                 Background="Transparent" Padding="18,14" Foreground="{StaticResource TextPrimary}"
                 CaretBrush="{StaticResource TextPrimary}" FontFamily="{StaticResource UiFont}"
                 TextChanged="OnQueryChanged"/>
        <Border x:Name="AccentLine" Grid.Row="1" Height="2"
                Background="{StaticResource AccentGradient}" Opacity="0.3"/>
      </Grid>
      <ItemsControl x:Name="Rows" MaxHeight="308" Margin="0,6,0,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border x:Name="RowBorder" Padding="10,8" Margin="6,1" CornerRadius="8" Background="Transparent">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="3"/>
                  <ColumnDefinition Width="34"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="AccentBar" Grid.Column="0" Width="3" CornerRadius="2"
                        Background="{StaticResource AccentGradient}" Opacity="0"/>
                <TextBlock Grid.Column="1" Text="{Binding Glyph}"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="16" Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Title}" FontFamily="{StaticResource UiFont}"
                             Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Detail}" FontFamily="{StaticResource MonoFont}"
                             FontSize="10.5" Foreground="{StaticResource TextMuted}"
                             TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Grid.Column="3" Text="{Binding KindLabel}" FontFamily="{StaticResource MonoFont}"
                           FontSize="9.5" Foreground="{StaticResource TextHint}"
                           VerticalAlignment="Center" Margin="10,0"/>
                <TextBlock Grid.Column="4" Text="&#xE73E;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           Foreground="{StaticResource ReadyGreen}" FontSize="15"
                           VerticalAlignment="Center" Visibility="{Binding ReadyVisibility}"/>
              </Grid>
            </Border>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource RowSelected}"/>
                <Setter TargetName="AccentBar" Property="Opacity" Value="1"/>
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Grid x:Name="Footer" Height="34" Margin="18,4,18,10">
        <TextBlock x:Name="FooterLeft" FontFamily="{StaticResource MonoFont}" FontSize="11"
                   Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="FooterRight" FontFamily="{StaticResource MonoFont}" FontSize="11"
                   Foreground="{StaticResource TextHint}" HorizontalAlignment="Right"
                   VerticalAlignment="Center"/>
      </Grid>
    </StackPanel>
  </Border>
</Window>
